{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    { "token": "comment", "foreground": "6A9955", "fontStyle": "italic" },
    { "token": "string", "foreground": "CE9178" },
    { "token": "keyword", "foreground": "C586C0" },
    { "token": "number", "foreground": "B5CEA8" },
    { "token": "function", "foreground": "DCDCAA" }
  ],
  "colors": {
    "foreground": "#D6E2E8",
    "focusBorder": "#2DD4BF",
    "sideBar.background": "#14242B",
    "sideBar.foreground": "#D6E2E8",
    "sideBarSectionHeader.foreground": "#8FB8BE",
    "sideBar.border": "#25434A",
    "panel.background": "#14242B",
    "panel.border": "#25434A",
    "titleBar.activeBackground": "#0C171D",
    "titleBar.activeForeground": "#D6E2E8",
    "statusBar.background": "#0C171D",
    "statusBar.foreground": "#8FB8BE",
    "input.background": "#0C171D",
    "input.foreground": "#D6E2E8",
    "input.border": "#25434A",
    "button.background": "#167D80",
    "button.foreground": "#F2FFFF",
    "list.hoverBackground": "#203940",
    "list.activeSelectionBackground": "#24565A",
    "tab.activeBackground": "#101820",
    "tab.inactiveBackground": "#14242B",
    "editor.background": "#101820",
    "editor.foreground": "#D6E2E8",
    "editorLineNumber.foreground": "#64748B",
    "editorLineNumber.activeForeground": "#E2E8F0",
    "editorCursor.foreground": "#2DD4BF",
    "editor.selectionBackground": "#24565A",
    "editor.inactiveSelectionBackground": "#1D3B40",
    "editor.lineHighlightBackground": "#16232B",
    "editorLineNumber.background": "#101820"
  }
}
