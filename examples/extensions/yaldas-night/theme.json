{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    { "token": "comment", "foreground": "#8E91A8", "fontStyle": "italic" },
    { "token": "string", "foreground": "#A8C98A" },
    { "token": "keyword", "foreground": "#F07883" },
    { "token": "number", "foreground": "#E8C879" },
    { "token": "function", "foreground": "#E9A1A8" },
    { "token": "type", "foreground": "#8CC9C0" }
  ],
  "colors": {
    "foreground": "#F2EAF0",
    "focusBorder": "#E66B79",
    "sideBar.background": "#211B2B",
    "sideBar.foreground": "#F2EAF0",
    "sideBarSectionHeader.foreground": "#C2A9BC",
    "sideBar.border": "#413047",
    "panel.background": "#211B2B",
    "panel.border": "#413047",
    "titleBar.activeBackground": "#17121F",
    "titleBar.activeForeground": "#F2EAF0",
    "statusBar.background": "#17121F",
    "statusBar.foreground": "#D8B9C8",
    "input.background": "#17121F",
    "input.foreground": "#F2EAF0",
    "input.border": "#493348",
    "button.background": "#A93450",
    "button.foreground": "#FFF5F3",
    "list.hoverBackground": "#33263B",
    "list.activeSelectionBackground": "#563044",
    "tab.activeBackground": "#292031",
    "tab.inactiveBackground": "#211B2B",
    "editor.background": "#17121F",
    "editor.foreground": "#F2EAF0",
    "editorLineNumber.foreground": "#776B82",
    "editorLineNumber.activeForeground": "#E9D9E8",
    "editorCursor.foreground": "#F07883",
    "editor.selectionBackground": "#563044",
    "editor.inactiveSelectionBackground": "#3A293D",
    "editor.lineHighlightBackground": "#211A2A",
    "editorWidget.background": "#211B2B",
    "editorWidget.border": "#493348"
  }
}
